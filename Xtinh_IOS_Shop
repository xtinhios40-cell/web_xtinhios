<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="XTINHIOS STORE - Shop game, kim cương, acc game và vật phẩm">
<title>XTINHIOS STORE</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#060a14;
    color:#fff;
}

a{
    text-decoration:none;
    color:white;
}

header{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(5,9,20,.96);
    border-bottom:1px solid #263552;
}

.nav{
    max-width:1250px;
    margin:auto;
    min-height:70px;
    padding:12px 18px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.logo{
    font-size:27px;
    font-weight:900;
    color:#00d9ff;
    white-space:nowrap;
}

.logo span{
    color:white;
}

.search{
    flex:1;
    max-width:500px;
    display:flex;
}

.search input{
    width:100%;
    padding:13px 16px;
    border:1px solid #263552;
    border-radius:12px;
    outline:none;
    background:#101827;
    color:white;
}

.menu{
    display:flex;
    gap:8px;
    align-items:center;
}

.menu a,
.login{
    padding:11px 14px;
    border-radius:10px;
    color:#dbeafe;
}

.menu a:hover,
.login:hover{
    background:#172238;
}

.login{
    background:linear-gradient(90deg,#2563eb,#7c3aed);
}

.hero{
    max-width:1250px;
    margin:auto;
    padding:28px 18px;
}

.hero-box{
    min-height:330px;
    padding:45px;
    border:1px solid #27446c;
    border-radius:25px;
    overflow:hidden;
    background:
        radial-gradient(circle at 20% 20%,#123c68,transparent 35%),
        radial-gradient(circle at 80% 50%,#43216e,transparent 40%),
        linear-gradient(135deg,#0b162b,#120c27);
    display:flex;
    align-items:center;
}

.hero-content{
    max-width:720px;
}

.badge{
    display:inline-block;
    padding:8px 14px;
    border-radius:30px;
    background:#092d42;
    color:#5ee7ff;
    margin-bottom:15px;
}

.hero h1{
    font-size:clamp(38px,6vw,68px);
    line-height:1;
    margin-bottom:18px;
}

.hero h1 span{
    color:#00d9ff;
}

.hero p{
    color:#b9c7dc;
    line-height:1.7;
}

.buttons{
    display:flex;
    gap:12px;
    margin-top:25px;
    flex-wrap:wrap;
}

.btn{
    border:0;
    cursor:pointer;
    padding:13px 20px;
    border-radius:11px;
    font-weight:bold;
    color:white;
}

.primary{
    background:linear-gradient(90deg,#00bfff,#2563eb);
}

.secondary{
    background:#18243a;
    border:1px solid #334155;
}

.container{
    max-width:1250px;
    margin:auto;
    padding:0 18px;
}

.title{
    margin:25px 0 15px;
}

.title h2{
    font-size:28px;
}

.title p{
    color:#8493a9;
    margin-top:5px;
}

.categories{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
    gap:12px;
}

.category{
    background:#101827;
    border:1px solid #263552;
    border-radius:15px;
    padding:20px 10px;
    text-align:center;
    cursor:pointer;
    transition:.2s;
}

.category:hover{
    transform:translateY(-4px);
    border-color:#00d9ff;
}

.icon{
    font-size:35px;
}

.category b{
    display:block;
    margin-top:9px;
}

.category small{
    color:#7f8da3;
}

.products{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
    gap:15px;
}

.product{
    background:linear-gradient(180deg,#121b2d,#0b111d);
    border:1px solid #263552;
    border-radius:16px;
    overflow:hidden;
    transition:.2s;
}

.product:hover{
    transform:translateY(-5px);
    border-color:#2563eb;
    box-shadow:0 15px 40px rgba(0,0,0,.35);
}

.product-image{
    height:145px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:65px;
    background:linear-gradient(135deg,#0d3150,#25134b);
}

.product-body{
    padding:16px;
}

.product h3{
    font-size:17px;
    margin-bottom:7px;
}

.product p{
    color:#8290a5;
    font-size:13px;
}

.price{
    color:#5ee7ff;
    font-size:21px;
    font-weight:900;
    margin:14px 0;
}

.buy{
    width:100%;
    background:linear-gradient(90deg,#2563eb,#7c3aed);
}

.features{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:14px;
    margin:30px 0;
}

.feature{
    background:#101827;
    border:1px solid #263552;
    padding:20px;
    border-radius:15px;
}

.feature strong{
    display:block;
    margin-bottom:7px;
}

.feature span{
    color:#8493a9;
    font-size:14px;
}

footer{
    margin-top:40px;
    padding:30px 18px;
    text-align:center;
    background:#080d18;
    border-top:1px solid #263552;
    color:#718096;
}

.modal{
    display:none;
    position:fixed;
    inset:0;
    z-index:2000;
    background:rgba(0,0,0,.75);
    align-items:center;
    justify-content:center;
    padding:20px;
}

.modal.active{
    display:flex;
}

.modal-box{
    width:100%;
    max-width:420px;
    padding:25px;
    border-radius:18px;
    background:#101827;
    border:1px solid #334155;
}

.modal-box h2{
    margin-bottom:15px;
}

.modal-box input{
    width:100%;
    padding:13px;
    margin:7px 0;
    border-radius:10px;
    border:1px solid #334155;
    background:#080e1a;
    color:white;
    outline:none;
}

.close{
    float:right;
    border:0;
    background:none;
    color:white;
    font-size:27px;
    cursor:pointer;
}

@media(max-width:800px){

    .nav{
        flex-wrap:wrap;
    }

    .search{
        order:3;
        max-width:none;
        width:100%;
    }

    .menu a{
        display:none;
    }

    .hero-box{
        padding:30px 20px;
    }

    .hero h1{
        font-size:42px;
    }
}
</style>
</head>

