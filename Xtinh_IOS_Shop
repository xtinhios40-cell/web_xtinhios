</div>


<script>

function buy(product){

    alert(
        "Bạn đã chọn: " +
        product +
        "\n\n" +
        "Đây là bản demo XTINHIOS."
    );

}


function openLogin(){

    document
        .getElementById("loginModal")
        .classList
        .add("active");

}


function closeLogin(){

    document
        .getElementById("loginModal")
        .classList
        .remove("active");

}


function loginDemo(){

    alert(
        "Đăng nhập đang ở chế độ demo.\n" +
        "Bạn cần kết nối backend để sử dụng tài khoản thật."
    );

}


function searchProduct(){

    let keyword =
        document
        .getElementById("search")
        .value
        .toLowerCase();

    let products =
        document.querySelectorAll(".product");

    products.forEach(function(product){

        let name =
            product
            .querySelector("h3")
            .innerText
            .toLowerCase();

        if(name.includes(keyword)){
            product.style.display="";
        }
        else{
            product.style.display="none";
        }

    });

}

</script>

